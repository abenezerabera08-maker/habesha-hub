-- SECTION 8: payment_proofs
-- =============================================================================

alter table public.payment_proofs enable row level security;

drop policy if exists "payment_proofs_select_owner" on public.payment_proofs;
drop policy if exists "payment_proofs_insert_owner" on public.payment_proofs;
drop policy if exists "payment_proofs_delete_owner" on public.payment_proofs;

create policy "payment_proofs_select_owner" on public.payment_proofs
  for select
  using (
    exists (
      select 1
      from public.payments p
      join public.orders o on o.id = p.order_id
      where p.id = payment_proofs.payment_id
        and (
          o.user_id = auth.uid()
          or exists (
            select 1
            from public.events e
            where e.id = o.event_id
              and (e.organizer_id = auth.uid() or is_admin())
          )
        )
    )
  );

create policy "payment_proofs_insert_owner" on public.payment_proofs
  for insert
  with check (
    exists (
      select 1
      from public.payments p
      join public.orders o on o.id = p.order_id
      where p.id = payment_proofs.payment_id
        and o.user_id = auth.uid()
    )
  );

create policy "payment_proofs_delete_owner" on public.payment_proofs
  for delete
  using (
    exists (
      select 1
      from public.payments p
      join public.orders o on o.id = p.order_id
      where p.id = payment_proofs.payment_id
        and o.user_id = auth.uid()
    )
  );

