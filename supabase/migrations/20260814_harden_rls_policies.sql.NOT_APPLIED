-- =============================================================================
-- SECTION 12: reference tables (interests, cities) — public read-only
-- =============================================================================

alter table public.interests enable row level security;
alter table public.cities enable row level security;

drop policy if exists "interests_select_all" on public.interests;
drop policy if exists "cities_select_all" on public.cities;

create policy "interests_select_all" on public.interests
  for select
  using (true);

create policy "cities_select_all" on public.cities
  for select
  using (true);

-- CHECK 12:
select tablename, policyname, cmd, roles
from pg_policies
where tablename in ('interests', 'cities')
order by tablename, policyname;

-- =============================================================================
-- SECTION 13: default role for new profiles
-- =============================================================================

-- The app sets `role` explicitly through /api/role at signup, but a fresh
-- profile (or any insert that omits role) should never default to a
-- privileged value.
alter table public.profiles
  alter column role set default 'customer';

-- CHECK 13: shows the new default ('customer').
select column_name, column_default
from information_schema.columns
where table_schema = 'public'
  and table_name = 'profiles'
  and column_name = 'role';

-- =============================================================================
-- FULL VERIFICATION (run after all sections)
-- =============================================================================

-- 1. Every table the app writes to must have RLS enabled.
select tablename, relrowsecurity as rls_enabled
from pg_class c
join pg_namespace n on n.oid = c.relnamespace
join pg_tables t on t.tablename = c.relname and t.schemaname = n.nspname
where n.nspname = 'public'
  and c.relname in (
    'profiles', 'events', 'ticket_tiers', 'event_payment_methods',
    'orders', 'payments', 'payment_proofs', 'payment_verifications',
    'user_interests', 'organizer_profiles', 'interests', 'cities'
  )
order by tablename;

-- 2. No policy may grant the `anon` role a write command (insert/update/delete).
select tablename, policyname, cmd, roles
from pg_policies
where roles::text like '%anon%'
  and cmd in ('INSERT', 'UPDATE', 'DELETE')
order by tablename;

-- 3. Post-write spot checks for the app's flows (run after exercising the UI):
--    UPDATE orders            SET status = 'confirmed' WHERE id = '<ORDER_ID>';
--    SELECT status FROM orders WHERE id = '<ORDER_ID>';
--    SELECT status FROM payments WHERE id = '<PAYMENT_ID>';
--    SELECT status FROM events WHERE id = '<EVENT_ID>';
