-- NOT APPLIED: superseded by existing hand-verified RLS policies already
-- live in production (see AGENTS.md). Running this would create duplicate
-- policies under different names rather than replacing anything. Kept for
-- reference only.
-- =============================================================================
-- Habesha Hub — RLS Hardening
-- Date: 2026-08-14
-- Applies to: profiles, events, ticket_tiers, event_payment_methods, orders,
--            payments, payment_proofs, payment_verifications, user_interests,
--            organizer_profiles, interests, cities
--
-- Run this in the Supabase SQL editor, section by section, and run the CHECK
-- query at the end of each section before moving on. Never bundle two sections
-- together.
--
-- Background (see AGENTS.md "RLS silent-failure pattern"): Supabase does not
-- throw when a write is blocked by RLS — the client reports success and the DB
-- silently keeps the old value. This script closes every write path the app
-- uses so blocked writes surface as errors instead of silent no-ops.
-- =============================================================================

-- =============================================================================
-- SECTION 1: helper functions
-- =============================================================================

-- is_admin() is SECURITY DEFINER so that policies on `profiles` (which read the
-- profiles table) do not recurse infinitely.
create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles
    where id = auth.uid() and role = 'admin'
  )
$$;

-- CHECK 1: the function exists and returns false for non-admins.
select pg_get_functiondef('public.is_admin()'::regprocedure);

-- =============================================================================
-- SECTION 2: profiles
-- =============================================================================

alter table public.profiles enable row level security;

-- Drop generic auto-generated policies that let any authenticated user read or
-- write any profile row. Adjust names if pg_policies shows different ones.
drop policy if exists "Enable insert for authenticated users only" on public.profiles;
drop policy if exists "Enable read access for all users" on public.profiles;
drop policy if exists "Enable update for users based on email" on public.profiles;
drop policy if exists "Enable all access to authenticated users" on public.profiles;

drop policy if exists "profiles_select_own_or_organizer" on public.profiles;
drop policy if exists "profiles_insert_own" on public.profiles;
drop policy if exists "profiles_update_own" on public.profiles;

create policy "profiles_select_own_or_organizer" on public.profiles
  for select
  using (
    id = auth.uid()
    or is_admin()
    or exists (
      select 1
      from public.orders o
      join public.events e on e.id = o.event_id
      where o.user_id = profiles.id
        and (e.organizer_id = auth.uid() or is_admin())
    )
  );

create policy "profiles_insert_own" on public.profiles
  for insert
  with check (id = auth.uid());

create policy "profiles_update_own" on public.profiles
  for update
  using (id = auth.uid() or is_admin())
  with check (id = auth.uid() or is_admin());

-- CHECK 2: exactly the three policies above exist, no `anon` role has write.
select policyname, cmd, roles
from pg_policies
where tablename = 'profiles'
order by policyname;

-- =============================================================================
-- SECTION 3: events
-- =============================================================================

alter table public.events enable row level security;

drop policy if exists "events_select_public_or_owner" on public.events;
drop policy if exists "events_insert_organizer" on public.events;
drop policy if exists "events_update_owner" on public.events;
drop policy if exists "events_delete_owner" on public.events;

create policy "events_select_public_or_owner" on public.events
  for select
  using (status = 'published' or organizer_id = auth.uid() or is_admin());

create policy "events_insert_organizer" on public.events
  for insert
  with check (organizer_id = auth.uid() and status in ('draft', 'pending_review'));

create policy "events_update_owner" on public.events
  for update
  using (organizer_id = auth.uid() or is_admin())
  with check (organizer_id = auth.uid() or is_admin());

create policy "events_delete_owner" on public.events
  for delete
  using (organizer_id = auth.uid() or is_admin());

-- CHECK 3: no `anon` role appears on events, and no leftover broad policies.
select policyname, cmd, roles
from pg_policies
where tablename = 'events'
order by policyname;

