alter table public.orders enable row level security;

drop policy if exists "orders_select_owner" on public.orders;
drop policy if exists "orders_insert_owner" on public.orders;
drop policy if exists "orders_update_owner" on public.orders;
drop policy if exists "orders_delete_owner" on public.orders;

create policy "orders_select_owner" on public.orders
  for select
  using (
    user_id = auth.uid()
    or exists (
      select 1
      from public.events e
      where e.id = orders.event_id
        and (e.organizer_id = auth.uid() or is_admin())
    )
  );

create policy "orders_insert_owner" on public.orders
  for insert
  with check (user_id = auth.uid());

create policy "orders_update_owner" on public.orders
  for update
  using (
    user_id = auth.uid()
    or exists (
      select 1
      from public.events e
      where e.id = orders.event_id
        and (e.organizer_id = auth.uid() or is_admin())
    )
  )
  with check (
    user_id = auth.uid()
    or exists (
      select 1
      from public.events e
      where e.id = orders.event_id
        and (e.organizer_id = auth.uid() or is_admin())
    )
  );

create policy "orders_delete_owner" on public.orders
  for delete
  using (user_id = auth.uid());

